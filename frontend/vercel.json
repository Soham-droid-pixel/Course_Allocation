{
  "version": 2,
  "name": "course-allocation-frontend",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://course-allocation-02wj.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://course-allocation-02wj.onrender.com/auth/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://course-allocation-02wj.onrender.com"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}