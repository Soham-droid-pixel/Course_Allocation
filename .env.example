# Environment Configuration Example

# Debug Mode
DEBUG=true

# Logging Level (e.g., debug, info, warning, error)
LOG_LEVEL=debug

# Secret Key for JWT or other encryption/auth
SECRET_KEY=your_secret_key_here

# MongoDB Atlas Configuration
# Replace <username>, <password>, and <cluster-url> with actual values
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/your_db_name?retryWrites=true&w=majority

# MongoDB Database Name
MONGO_DB_NAME=your_db_name_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
